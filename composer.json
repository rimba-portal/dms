{
  "name": "rimba/dms",
  "description": "Document Management System complying to QMS",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "BIT Ecosystem",
      "email": "bit.ecosystem@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "packstub/filament-flow": "^1.0",
    "rimba/asas": "*",
    "rimba/sifat": "*"
  },
  "autoload": {
    "psr-4": {
      "Rimba\\Document\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rimba\\Document\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rimba\\Document\\DocumentServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}